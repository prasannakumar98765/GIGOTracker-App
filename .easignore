# Dependency cache (server will install fresh)
node_modules/

# Native build output (OK to exclude)
android/.gradle/
android/.cxx/
android/build/
ios/build/
ios/Pods/

# Expo and Metro cache
.expo/
.expo-shared/
dist/
web-build/
.metro-health-check*

# System & IDE junk
.DS_Store
.vscode/
.idea/
*.iml

# Logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# Env & secrets
.env
.env.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# TypeScript cache
*.tsbuildinfo

# Git merge junk
*.orig.*
*.pem
